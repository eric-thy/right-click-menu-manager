<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
      xmlns:cmm="clr-namespace:Cmm;assembly=ContextMenuManager"
      Background="#F3F5F8"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">
  <Grid.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <cmm:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <cmm:EntryFilterMatchConverter x:Key="FilterMatch"/>
    <cmm:NullToVisibilityConverter x:Key="NullToVis"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4DBE4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A202C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667180"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#929CAA"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F7EE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF6E0"/>

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="FaintText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="NavHeaderText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
      <Setter Property="Margin" Value="12,15,12,5"/>
    </Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FocuslessButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#F3F6FA"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="#C5D0DD"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EAF0F6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#FADBD7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeroPrimaryButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="#0B3B6F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EAF3FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeroSecondaryButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#22FFFFFF"/>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="#465264"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,1,0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E9EDF3"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E5F0FB"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EFF3F8"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="#4B5565"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E8ECF2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="#4B5565"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwitchButtonStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="ToolTip" Value="{Binding SwitchHint}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="46" Height="26">
              <Border x:Name="Track" Background="#D7DDE6" CornerRadius="13"/>
              <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" Margin="3,0,0,0" HorizontalAlignment="Left">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.22" Color="#1A202C"/>
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                <Setter TargetName="Thumb" Property="Opacity" Value="0.7"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.86"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EFF3F8"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#B9CADD"/>
                <Setter TargetName="Root" Property="Background" Value="#FCFDFE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="InputTextBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EFF3F8"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="IsTextSearchEnabled" Value="True"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    Margin="10,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                  <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#667180"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ToggleButton x:Name="DropDownToggle" Background="Transparent" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                        Width="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True" Margin="3">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="#B9C6D6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Outer" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EntryItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter HorizontalAlignment="Stretch"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="NavItemTemplate">
      <Grid Margin="10,0,10,0">
        <TextBlock x:Name="HeaderText" Text="{Binding Title}" Style="{StaticResource NavHeaderText}" Visibility="Collapsed"/>
        <Button x:Name="NavButton" Style="{StaticResource NavButtonStyle}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                CommandParameter="{Binding}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="15" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Background="#E1E7EF" CornerRadius="9" Padding="6,1" VerticalAlignment="Center"
                    Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#5A6677" HorizontalAlignment="Center"/>
            </Border>
          </Grid>
        </Button>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHeader}" Value="True">
          <Setter TargetName="HeaderText" Property="Visibility" Value="Visible"/>
          <Setter TargetName="NavButton" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="MenuEntryTemplate">
      <Border Margin="0,0,0,8" BorderThickness="1" CornerRadius="12" Padding="14,11">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FCFDFE"/>
                <Setter Property="BorderBrush" Value="#C9D6E5"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <Grid Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Background="{Binding IconBackground}" CornerRadius="10"/>
            <TextBlock Text="{Binding IconLetter}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding Icon}" Width="27" Height="27" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420"/>
              <Border Background="{Binding BadgeBackground}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
              </Border>
              <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="5" Padding="5,2" Margin="5,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsExternalDisabled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="外部阻止" FontSize="9.5" Foreground="{StaticResource WarningBrush}"/>
              </Border>
              <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource WarningBrush}"
                         Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="此项需要管理员权限"
                         Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding ScopeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Style="{StaticResource SwitchButtonStyle}"
                    AutomationProperties.Name="{Binding ToggleAutomationName}"
                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                    CommandParameter="{Binding}"/>
          </StackPanel>
          <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                  AutomationProperties.Name="{Binding DetailsAutomationName}"
                  Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                  CommandParameter="{Binding}" ToolTip="查看详情">
            <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="15"/>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="HistoryItemTemplate">
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#F1F4F8" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="ToastActionButton" TargetType="Button" BasedOn="{StaticResource FocuslessButton}">
      <Setter Property="Foreground" Value="#9CD2FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="52"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Title bar -->
  <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1">
    <Grid Margin="16,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="TitleIcon" Width="24" Height="24" Margin="0,0,10,0"/>
        <TextBlock Text="右键菜单管理器" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        <Border Background="#EAF0F7" CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Windows 11" FontSize="9.5" Foreground="#66778C"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PermissionPill" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                AutomationProperties.Name="{Binding PermissionPillText}"
                Command="{Binding ElevateCommand}" IsEnabled="{Binding CanElevate}"
                ToolTip="{Binding PermissionHint}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Fill="{Binding PermissionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PermissionPillText}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnMinimize" Style="{StaticResource WindowButtonStyle}" ToolTip="最小化" AutomationProperties.Name="最小化"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
        </Button>
        <Button x:Name="BtnMaximize" Style="{StaticResource WindowButtonStyle}" ToolTip="最大化" AutomationProperties.Name="最大化"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock x:Name="BtnMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource CloseButtonStyle}" ToolTip="关闭" AutomationProperties.Name="关闭窗口"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#F3F5F8" BorderBrush="#E6EAF0" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavItemTemplate}" Margin="0,9,0,10"/>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="12,8,12,12" Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="26" Height="26" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" VerticalAlignment="Top">
              <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{Binding PermissionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="{Binding PermissionHint}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Main card -->
    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="14" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="WarningButton" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="0,0,8,0"
                    AutomationProperties.Name="扫描警告"
                    Command="{Binding ShowWarningsCommand}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding WarningsText}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding WarningsText}" FontSize="10.5" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border x:Name="SearchHost" Width="188" Height="34" Background="#F7F9FC" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0"
                    Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
              <Grid Margin="9,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1">
                  <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                           AutomationProperties.Name="搜索菜单项"
                           FontFamily="Microsoft YaHei UI" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"
                           CaretBrush="{StaticResource AccentBrush}" FocusVisualStyle="{x:Null}"/>
                  <TextBlock Text="搜索菜单项…" FontSize="11.5" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </Border>
            <Button x:Name="AddCustomButton" Style="{StaticResource PrimaryButton}" Padding="11,6" Margin="0,0,8,0"
                    AutomationProperties.Name="新建自定义项"
                    Command="{Binding AddCustomCommand}" Visibility="{Binding ShowAddCustom, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="新建" FontSize="11.5" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" ToolTip="重新扫描所有菜单来源"
                    AutomationProperties.Name="刷新扫描">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="刷新" FontSize="11.5" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Filter row -->
        <Grid Grid.Row="1" Margin="24,0,24,9" Visibility="{Binding ShowFilterBar, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="FilterAll" Content="全部" Style="{StaticResource FilterToggleStyle}"
                          IsChecked="{Binding Filter, Converter={StaticResource FilterMatch}, ConverterParameter=All, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}" CommandParameter="All"/>
            <ToggleButton x:Name="FilterEnabled" Content="已启用" Style="{StaticResource FilterToggleStyle}"
                          IsChecked="{Binding Filter, Converter={StaticResource FilterMatch}, ConverterParameter=Enabled, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}" CommandParameter="Enabled"/>
            <ToggleButton x:Name="FilterDisabled" Content="已禁用" Style="{StaticResource FilterToggleStyle}"
                          IsChecked="{Binding Filter, Converter={StaticResource FilterMatch}, ConverterParameter=Disabled, Mode=OneWay}"
                          Command="{Binding SetFilterCommand}" CommandParameter="Disabled"/>
          </StackPanel>
          <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource FaintText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- List -->
        <Grid Grid.Row="2" x:Name="ListPanel" Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#F7F9FC" BorderBrush="#E8ECF2" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="18,0,18,9"
                  Visibility="{Binding ShowFileTypeBar, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="文件类型" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox Grid.Column="1" x:Name="FileTypeCombo" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding FileTypes}"
                        AutomationProperties.Name="选择文件类型"
                        SelectedItem="{Binding SelectedFileType, Mode=TwoWay}" DisplayMemberPath="Display" MaxDropDownHeight="320"/>
              <TextBlock Grid.Column="2" Text="只显示专门注册给该类型的项目；所有文件通用项请到“文件”分类管理。" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="18,0,18,14">
            <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource MenuEntryTemplate}"
                     ItemContainerStyle="{StaticResource EntryItemStyle}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Padding="0"/>
            <Grid x:Name="EmptyState" Background="White" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="52" Height="52" CornerRadius="14" Background="#F2F5F9" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#A1ADBC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <!-- Dashboard -->
        <ScrollViewer Grid.Row="2" x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}">
          <StackPanel Margin="24,6,24,24">
            <Border CornerRadius="16" Padding="26,23">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#0C3B73" Offset="0"/>
                  <GradientStop Color="#0F6CBD" Offset="0.65"/>
                  <GradientStop Color="#1684D8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="把右键菜单交还给你" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                  <TextBlock Text="完整识别 Win11 现代菜单、经典注册表菜单、Shell 扩展、新建菜单与发送到项目。所有开关都可逆。"
                             FontSize="12" Foreground="#D7E9FF" TextWrapping="Wrap" MaxWidth="590" Margin="0,8,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource HeroPrimaryButton}" Command="{Binding GoToCategoryCommand}" CommandParameter="all" Content="开始管理"/>
                    <Button Style="{StaticResource HeroSecondaryButton}" Command="{Binding RefreshCommand}" Content="重新扫描" Margin="9,0,0,0"/>
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                  <Ellipse Width="108" Height="108" Fill="#18FFFFFF"/>
                  <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="43" Foreground="#DFF0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,12,0,0">
              <Button Style="{StaticResource StatCardStyle}" Margin="0,0,8,0" Command="{Binding GoToCategoryCommand}" CommandParameter="modern">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding ModernCount}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Win11 现代菜单" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE945;" Style="{StaticResource IconGlyph}" FontSize="19" Foreground="#B7D4F4" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource StatCardStyle}" Margin="0,0,8,0" Command="{Binding GoToCategoryCommand}" CommandParameter="shellext">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding ShellCount}" FontSize="25" FontWeight="SemiBold" Foreground="#6941AE"/>
                    <TextBlock Text="Shell 扩展" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE74C;" Style="{StaticResource IconGlyph}" FontSize="19" Foreground="#D8CAF0" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource StatCardStyle}" Margin="0,0,8,0" Command="{Binding GoToCategoryCommand}" CommandParameter="classic">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding ClassicCount}" FontSize="25" FontWeight="SemiBold" Foreground="#465264"/>
                    <TextBlock Text="经典菜单项" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE8FD;" Style="{StaticResource IconGlyph}" FontSize="19" Foreground="#C8D0DA" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource StatCardStyle}" Command="{Binding GoToCategoryCommand}" CommandParameter="disabled">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding DisabledCount}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="已禁用项目" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="19" Foreground="#F0C8C3" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </UniformGrid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.32*"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="最近更改" Style="{StaticResource CardTitleText}"/>
                    <Button Content="查看全部" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" FontSize="11"
                            Command="{Binding GoToCategoryCommand}" CommandParameter="settings"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding RecentChanges}" ItemTemplate="{StaticResource HistoryItemTemplate}" Margin="0,8,0,0"/>
                  <TextBlock Text="还没有通过本工具做过修改。" Style="{StaticResource MutedText}" Margin="0,12,0,4"
                             Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="安全提示" Style="{StaticResource CardTitleText}"/>
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="• 所有开关都写入可逆的注册表值，不删除原命令。" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <TextBlock Text="• 现代菜单通过阻止 CLSID 隐藏，可随时恢复。" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <TextBlock Text="• 系统级项目会标出管理员图标，避免误改。" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <TextBlock Text="• 修改菜单后可在设置中重启资源管理器。" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}">
          <StackPanel Margin="24,6,24,24">
            <Border Style="{StaticResource CardBorderStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                  <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="17" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,20,0">
                  <TextBlock Text="运行权限" Style="{StaticResource CardTitleText}"/>
                  <TextBlock Text="{Binding PermissionHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                  <TextBlock Text="提升后会以管理员身份重启，可管理 HKEY_LOCAL_MACHINE 和所有用户目录中的项目。" Style="{StaticResource FaintText}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button Content="以管理员身份重启" Style="{StaticResource PrimaryButton}" Command="{Binding ElevateCommand}" IsEnabled="{Binding CanElevate}"/>
                  <TextBlock Text="{Binding PermissionText}" Style="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="备份与恢复" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="{Binding HistoryCountText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="撤销上次" Style="{StaticResource SecondaryButton}" Command="{Binding UndoCommand}" Margin="0,0,8,0"/>
                    <Button Content="恢复全部" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreAllCommand}"/>
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding RecentChanges}" ItemTemplate="{StaticResource HistoryItemTemplate}" Margin="0,10,0,0"/>
                <TextBlock Text="本工具会为每次修改记录修改前的值。恢复全部只撤销本工具做过的更改，不影响其他工具。" Style="{StaticResource FaintText}" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}"/>
                  <TextBlock Text="{Binding DataPath}" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,9,0">
                <StackPanel>
                  <TextBlock Text="资源管理器" Style="{StaticResource CardTitleText}"/>
                  <TextBlock Text="右键菜单由资源管理器缓存。修改现代菜单或阻止项后，重启资源管理器通常能立即生效。" Style="{StaticResource MutedText}" Margin="0,6,0,12"/>
                  <Button Content="立即重启资源管理器" Style="{StaticResource SecondaryButton}" Command="{Binding RestartExplorerCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="9,0,0,0">
                <StackPanel>
                  <TextBlock Text="右键菜单样式" Style="{StaticResource CardTitleText}"/>
                  <TextBlock Text="{Binding MenuStyleText}" Style="{StaticResource MutedText}" Margin="0,6,0,12"/>
                  <TextBlock Text="经典模式会展开 Windows 10 风格的完整菜单，第三方传统项目会直接出现。" Style="{StaticResource FaintText}" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="使用现代菜单" Style="{StaticResource SecondaryButton}" Command="{Binding UseModernMenuCommand}" Margin="0,0,8,0"/>
                    <Button Content="使用经典菜单" Style="{StaticResource SecondaryButton}" Command="{Binding UseClassicMenuCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="关于" Style="{StaticResource CardTitleText}"/>
                <TextBlock Text="右键菜单管理器 · Windows 11 全量右键菜单控制台" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                <TextBlock Text="扫描来源：HKEY_CURRENT_USER / HKEY_LOCAL_MACHINE 的经典 shell 动词、Shell 上下文菜单处理程序、PackagedCom 现代菜单、ShellNew 新建项、SendTo 发送到目录。" Style="{StaticResource FaintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource FaintText}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Panel.ZIndex="5" Background="#F2FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding BusyText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <ProgressBar IsIndeterminate="True" Width="230" Height="3" Foreground="{StaticResource AccentBrush}"
                         Background="#E7ECF3" BorderThickness="0" Margin="0,12,0,0"/>
            <TextBlock Text="正在读取所有已安装应用的菜单清单，请稍候…" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <!-- Toast -->
  <Border x:Name="ToastHost" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
          Background="#1F2937" CornerRadius="10" Padding="13,9" Margin="0,0,0,22" MaxWidth="820" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#8CE0B3" VerticalAlignment="Center" Margin="0,0,9,0"/>
      <TextBlock x:Name="ToastText" Text="" FontSize="11.5" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/>
      <Button x:Name="ToastAction" Content="撤销" Style="{StaticResource ToastActionButton}" Margin="12,0,0,0" Visibility="Collapsed"/>
      <Button x:Name="ToastClose" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Margin="6,0,0,0" Foreground="#B7C1CE" ToolTip="关闭">
        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="9"/>
      </Button>
    </StackPanel>
  </Border>

  <!-- Modal overlay -->
  <Grid x:Name="Overlay" Grid.RowSpan="2" Panel.ZIndex="30" Background="#730C1424" Visibility="Collapsed">
    <Border x:Name="DialogCard" Background="White" CornerRadius="16" Padding="0" MaxWidth="760" MaxHeight="800"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentControl x:Name="DialogBody" MaxHeight="800"/>
    </Border>
  </Grid>
</Grid>
